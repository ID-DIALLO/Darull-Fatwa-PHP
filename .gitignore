# Dépendances
/vendor/
/node_modules/

# Configuration locale et secrets
.env
.env.*
!.env.example

# Stockage (hors racine web) : on garde uniquement l'arborescence
/storage/*/*
!/storage/*/.gitkeep

# Fichiers envoyés par les utilisateurs
/public/uploads/*
!/public/uploads/.htaccess
!/public/uploads/.gitkeep

# Outils
.phpunit.cache/
.phpunit.result.cache
.idea/
.vscode/
.DS_Store
Thumbs.db
